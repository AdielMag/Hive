{
  "name": "hive",
  "private": true,
  "version": "0.14.0",
  "author": "Hive Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdielMag/Hive.git"
  },
  "description": "Desktop GUI for agentic coding on top of the Pi CLI",
  "type": "module",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "build": "npm --prefix apps/desktop run build",
    "typecheck": "node scripts/gen-modules.mjs && tsc -p packages/protocol && tsc -p packages/pi-adapter && tsc -p packages/test-provider && tsc -p packages/theme-engine && tsc -p packages/module-sdk && tsc -p modules && npm run typecheck -w @hive/desktop",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "gen:modules": "node scripts/gen-modules.mjs",
    "check:modules": "node scripts/gen-modules.mjs --check && node scripts/check-module-boundaries.mjs",
    "dist": "npm --prefix apps/desktop run dist",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "release:preview": "node scripts/release/prepare.mjs --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.19.0",
    "electron-builder": "^26.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
