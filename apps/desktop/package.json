{
  "name": "@hive/desktop",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Hive Desktop App",
  "author": "Hive Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdielMag/Hive.git"
  },
  "main": "./out/main/index.js",
  "bin": {
    "plan-previewer": "./bin/plan-previewer.js"
  },
  "scripts": {
    "dev": "node ../../scripts/gen-modules.mjs && electron-vite dev",
    "build": "node ../../scripts/gen-modules.mjs && electron-vite build && node scripts/build-bridge.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "node ../../scripts/gen-modules.mjs && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "icon": "electron build/render-icon.mjs"
  },
  "build": {
    "appId": "dev.pi.studio",
    "productName": "Hive",
    "executableName": "hive",
    "electronVersion": "35.7.5",
    "publish": {
      "provider": "github",
      "owner": "AdielMag",
      "repo": "Hive"
    },
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png",
    "asarUnpack": [
      "resources/**",
      "out/bridge/**"
    ],
    "artifactName": "Hive-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Hive-Setup-${version}.${ext}",
      "shortcutName": "Hive"
    },
    "portable": {
      "artifactName": "Hive-${version}-portable.${ext}"
    },
    "extraResources": [
      {
        "from": "../../modules",
        "to": "modules",
        "filter": [
          "*/package.json",
          "*/agent/**",
          "*/bin/**"
        ]
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hive/module-sdk": "0.1.0",
    "@hive/pi-adapter": "0.1.0",
    "@hive/protocol": "0.1.0",
    "@hive/theme-engine": "0.1.0",
    "@shikijs/langs": "^4.5.0",
    "culori": "^4.0.2",
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "35.7.5",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3",
    "vite": "^7.3.0"
  }
}
