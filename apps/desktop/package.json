{
  "name": "@pi-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Studio Desktop App",
  "author": "Pi Studio Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdielMag/pi-studio.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "dev.pi.studio",
    "productName": "Pi Studio",
    "executableName": "pi-studio",
    "electronVersion": "35.7.5",
    "publish": {
      "provider": "github",
      "owner": "AdielMag",
      "repo": "pi-studio"
    },
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@pi-studio/pi-adapter": "0.1.0",
    "@pi-studio/protocol": "0.1.0",
    "@pi-studio/theme-engine": "0.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "culori": "^4.0.2",
    "flexlayout-react": "^0.11.1",
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "35.7.5",
    "electron-vite": "^5.0.0",
    "typescript": "6.0.3",
    "vite": "^7.3.0"
  }
}
